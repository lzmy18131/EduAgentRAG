# 复制为 .env 后填写；不要提交真实凭据。

# DeepSeek（项目内部统一使用）
EDU_LLM_MODEL=deepseek-v4-pro
EDU_LLM_API_KEY=your_deepseek_api_key
EDU_LLM_BASE_URL=https://api.deepseek.com

# MySQL
EDU_MYSQL_HOST=localhost
EDU_MYSQL_USER=root
EDU_MYSQL_PASSWORD=your_mysql_password
EDU_MYSQL_DATABASE=subjects_kg

# Redis（无密码时留空）
EDU_REDIS_HOST=localhost
EDU_REDIS_PORT=6379
EDU_REDIS_PASSWORD=
EDU_REDIS_DB=0

# Milvus
EDU_MILVUS_HOST=localhost
EDU_MILVUS_PORT=19530
EDU_MILVUS_DATABASE_NAME=itcast
EDU_MILVUS_COLLECTION_NAME=edurag_0421

# RAGAS embedding：DeepSeek 不提供 embedding，评测时另配 OpenAI-compatible 服务
EDU_EVAL_EMBEDDING_MODEL=
EDU_EVAL_EMBEDDING_API_KEY=
EDU_EVAL_EMBEDDING_BASE_URL=

# Web 知识库上传管理密钥；请求时通过 X-API-Key 传递
EDU_APP_UPLOAD_API_KEY=replace_with_a_long_random_value
